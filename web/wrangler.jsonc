// Cloudflare Workers static-assets deploy of the Astro build.
// Workers Builds: root directory `web`, deploy `npx wrangler deploy`.
// Wrangler runs the build below first, so dist/ exists before upload.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghost-phylogeny-indonesia",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "bun install --frozen-lockfile && bun run build"
  },
  "assets": {
    "directory": "./dist"
  }
}
