---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import { byId, cladeVar, CODING_LABEL, DANGER, data, ghosts, plateUrl, sexLabel, withBase, type Ghost } from "../../utils/data";
import { layout } from "../../utils/tree";

export const getStaticPaths = (() => ghosts.map((g) => ({ params: { id: g.id } }))) satisfies GetStaticPaths;

const ghost = byId.get(Astro.params.id!) as Ghost;
const L = layout(data.tree, (id) => byId.get(id)!.clade);
const order = L.tips.map((t) => t.id!);
const at = order.indexOf(ghost.id);
const prev = byId.get(order[(at - 1 + order.length) % order.length])!;
const next = byId.get(order[(at + 1) % order.length])!;
const relatives = ghost.relatives.map((id) => byId.get(id)!);
const fields: [string, string | null][] = [
  ["Form", ghost.morphology],
  ["Origin", ghost.origin],
  ["Behaviour", ghost.behavior],
  ["Deterrents and vulnerabilities", ghost.deterrents],
  ["Diet", ghost.diet],
  ["Culture", ghost.culture],
  ["Region", ghost.region],
  ["Sampling", ghost.inSourceTree ? "In the original 61-taxon tree and in this one." : "Added in workbook v3; first placed on a tree here."],
];
const state = (i: number) => {
  const s = ghost.row[i];
  return s === "?" ? "Unknown" : data.characters[i].states[data.symbols.indexOf(s)];
};
---

<Layout title={`${ghost.name} · Ghost phylogeny, literally`} description={`${ghost.name}: ${ghost.morphology} from ${ghost.region}, placed on a phylogeny of Indonesian ghosts.`}>
  <nav class="mt-6 flex items-center justify-between gap-2 text-sm" aria-label="Neighbours on the tree">
    <a href={withBase(`/ghosts/${prev.id}`)} class="glass !rounded-full flex min-w-0 items-center gap-2 py-1 pl-1 pr-3">
      <img src={plateUrl(prev.id)} alt="" width="30" height="30" class="rounded-full" /><span class="truncate"><span aria-hidden="true">←</span> <span class="sr-only">Previous on the tree: </span>{prev.name}</span>
    </a>
    <a href={withBase(`/ghosts/${next.id}`)} class="glass !rounded-full flex min-w-0 items-center gap-2 py-1 pl-3 pr-1">
      <span class="truncate"><span class="sr-only">Next on the tree: </span>{next.name} <span aria-hidden="true">→</span></span><img src={plateUrl(next.id)} alt="" width="30" height="30" class="rounded-full" />
    </a>
  </nav>

  <article class="mt-6 grid gap-6 md:grid-cols-[18rem_minmax(0,1fr)]">
    <div class="glass self-start p-6 text-center md:sticky md:top-28">
      <img src={plateUrl(ghost.id)} alt={`${ghost.name}, drawn as ${ghost.morphology.toLowerCase()}`} width="240" height="240" class="mx-auto animate-drift rounded-full shadow-2xl shadow-malam-950/30" />
      <a href={plateUrl(ghost.id)} download class="muted mt-4 inline-block text-sm underline underline-offset-2">Download plate (SVG)</a>
    </div>
    <div class="grid gap-6">
      <div class="glass p-6">
        <p class="accent text-xs font-semibold uppercase tracking-[0.25em]">{ghost.regionGroup === "Outgroup" ? "Outgroup" : ghost.regionGroup}</p>
        <h1 class="mt-1 font-serif text-5xl font-semibold tracking-tight">{ghost.name}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-sm">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-kafan-700 px-3 py-1 font-semibold dark:border-kemenyan-400">
            <span class="h-2.5 w-2.5 rounded-full" style={`background: ${cladeVar(ghost.clade)}`}></span>
            {ghost.clade}
          </span>
          <span>Danger {ghost.danger} of 5 · {DANGER[ghost.danger]}</span>
        </div>
        <dl class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            fields.filter(([, v]) => v).map(([k, v]) => (
              <div class="rounded-2xl border border-kafan-300 bg-kafan-100/70 p-4 dark:border-malam-700 dark:bg-malam-900/70">
                <dt class="muted text-xs font-semibold uppercase tracking-wider">{k}</dt>
                <dd class="mt-1">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <section class="glass p-6" aria-labelledby="chars">
        <h2 id="chars" class="font-serif text-2xl font-semibold">Coded characters</h2>
        <p class="muted mt-1 text-sm">
          {ghost.coding !== "source" && "◆ "}{CODING_LABEL[ghost.coding]}. Sex: {sexLabel(ghost)}.
        </p>
        <table class="mt-3 w-full text-left text-sm">
          <caption class="sr-only">The {data.characters.length} characters coded for {ghost.name}</caption>
          <tbody>
            {
              data.characters.map((c, i) => (
                <tr class="border-t border-kafan-300 dark:border-malam-700">
                  <th scope="row" class="w-1/3 py-1.5 pr-3 font-semibold">{c.label}</th>
                  <td class={`py-1.5 ${ghost.row[i] === "1" && i < 18 ? "accent font-semibold" : ""}`}>
                    {ghost.row[i] === "1" && i < 18 && <span aria-hidden="true">● </span>}
                    {state(i)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <section class="glass p-6" aria-labelledby="near">
        <h2 id="near" class="font-serif text-2xl font-semibold">Nearest on the tree</h2>
        {ghost.twins.length > 0 && <p class="muted mt-1 text-sm">Identical coding to {ghost.twins.map((t) => byId.get(t)!.name).join(", ")}, so the tree cannot separate them.</p>}
        <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
          {
            relatives.map((r) => (
              <li>
                <a href={withBase(`/ghosts/${r.id}`)} class="flex h-full flex-col items-center rounded-2xl border border-kafan-300 bg-kafan-100/70 p-3 text-center text-sm transition hover:border-darah-600 dark:border-malam-700 dark:bg-malam-900/70 dark:hover:border-prada-400">
                  <img src={plateUrl(r.id)} alt="" width="64" height="64" class="rounded-full" />
                  <span class="mt-1 font-semibold leading-tight">{r.name}</span>
                  <span class="muted text-xs">{r.regionGroup}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </article>
</Layout>
