---
import Layout from "../layouts/Layout.astro";
import PageTitle from "../components/PageTitle.astro";
import GlassSection from "../components/GlassSection.astro";
import { ArchipelagoMap, BodyDiet, DangerUnits, Provenance, SupportHistogram, TraitHeatmap, Twins } from "../islands/Patterns";
import land from "../data/indonesia-land.json";
import { byId, data } from "../utils/data";
import { layout } from "../utils/tree";

// Equirectangular projection of the coastline to a fixed SVG frame.
const W = 960;
const H = Math.round((W * (land.bbox.north - land.bbox.south)) / (land.bbox.east - land.bbox.west));
const px = (lon: number) => (((lon - land.bbox.west) / (land.bbox.east - land.bbox.west)) * W).toFixed(1);
const py = (lat: number) => (((land.bbox.north - lat) / (land.bbox.north - land.bbox.south)) * H).toFixed(1);
const landPath = (land.rings as number[][][]).map((r) => "M" + r.map(([x, y]) => `${px(x)} ${py(y)}`).join("L") + "Z").join("");

const L = layout(data.tree, (id) => byId.get(id)!.clade);
const supports = L.all.filter((p) => p.children.length && p.support !== undefined).map((p) => p.support!);

// Data-driven leads, so the text always matches the charts.
const count = (f: (g: (typeof data.ghosts)[number]) => boolean) => data.ghosts.filter(f).length;
const regionCounts = data.regions.map((r) => [r, count((g) => g.regionGroup === r)] as const).sort((a, b) => b[1] - a[1]);
const lethal = count((g) => g.danger === 5);
const dangerByClade = data.clades
  .map((c) => {
    const gs = data.ghosts.filter((g) => g.clade === c);
    return [c, gs.reduce((s, g) => s + g.danger, 0) / gs.length] as const;
  })
  .sort((a, b) => b[1] - a[1]);
const synth = count((g) => g.coding !== "source");
const twinSets = new Set(data.ghosts.filter((g) => g.twins.length).map((g) => g.row)).size;
const blood = data.clades
  .map((c) => {
    const gs = data.ghosts.filter((g) => g.clade === c);
    return [c, gs.filter((g) => g.traits.predation_blood_organs === 1).length / gs.length] as const;
  })
  .sort((a, b) => b[1] - a[1])[0];
const bloodPlans = data.bodyPlans
  .map((b) => [b.label, count((g) => g.bodyPlan === b.id && g.dietClass === "Blood")] as const)
  .sort((a, b) => b[1] - a[1]);
const bloodTotal = count((g) => g.dietClass === "Blood");
const sections = [
  ["where", "Where they haunt"],
  ["traits", "What each clade is made of"],
  ["danger", "How dangerous"],
  ["bodies", "Bodies and diets"],
  ["support", "How sure the tree is"],
  ["twins", "Indistinguishable ghosts"],
  ["provenance", "Where the codings come from"],
];
---

<Layout title="Patterns · Ghost phylogeny, literally" wide>
  <PageTitle title="Patterns in the haunting" kicker="The whole dataset, chart by chart">
    The tree shows who is related to whom. These charts show everything else in the data: where each ghost lives, what it is made of, how dangerous it is, and how much of its coding is folklore synthesis.
  </PageTitle>

  <nav aria-label="Charts on this page" class="glass mx-auto mb-6 max-w-5xl px-4 py-3">
    <ul class="flex flex-wrap justify-center gap-2 text-sm">
      {sections.map(([id, label]) => <li><a href={`#${id}`} class="control inline-block px-3 py-1 hover:bg-kafan-200 dark:hover:bg-malam-800">{label}</a></li>)}
    </ul>
  </nav>

  <div class="mx-auto grid max-w-5xl gap-6">
    <GlassSection id="where" title="Where they haunt" lead={`${regionCounts[0][0]} has the most ghosts (${regionCounts[0][1]}), then ${regionCounts[1][0]} (${regionCounts[1][1]}) and ${regionCounts[2][0]} (${regionCounts[2][1]}). Widespread motifs and outgroups from beyond Indonesia sit in the dashed boxes.`}>
      <ArchipelagoMap client:visible land={landPath} width={W} height={H} />
    </GlassSection>

    <GlassSection id="traits" title="What each clade is made of" lead={`Each row is a clade, each column a coded trait. ${blood[0]} is the bloodiest clade: ${Math.round(blood[1] * 100)}% of its members target blood, flesh, or organs.`}>
      <TraitHeatmap client:visible />
    </GlassSection>

    <GlassSection id="danger" title="How dangerous" lead={`Each plate is one ghost, placed by clade and danger. ${lethal} are lethal in their dominant telling; ${dangerByClade[0][0]} has the highest mean danger (${dangerByClade[0][1].toFixed(1)} of 5).`}>
      <DangerUnits client:visible />
    </GlassSection>

    <GlassSection id="bodies" title="Bodies and diets" lead={`Body plan and diet are characters 19 and 20 of the matrix. Of the ${bloodTotal} blood-feeders, ${bloodPlans[0][1]} are ${bloodPlans[0][0].toLowerCase()}s and ${bloodPlans[1][1]} are ${bloodPlans[1][0].toLowerCase()}s.`}>
      <BodyDiet client:visible />
    </GlassSection>

    <GlassSection id="support" title="How sure the tree is" lead={`Ultrafast bootstrap support across all ${supports.length} internal nodes. Only ${data.meta.strongNodes} reach 95; ${data.meta.weakNodes} fall below 50.`}>
      <SupportHistogram client:visible supports={supports} />
    </GlassSection>

    <GlassSection id="twins" title="Indistinguishable ghosts" lead={`${twinSets} sets of ghosts share identical rows in the matrix, so no tree can separate them. They sit together with zero-length branches.`}>
      <Twins />
    </GlassSection>

    <GlassSection id="provenance" title="Where the codings come from" lead={`${synth} of ${data.ghosts.length} ghosts have some or all traits coded by folklore synthesis rather than the source matrix; the site marks them ◆.`}>
      <Provenance client:visible />
    </GlassSection>
  </div>
</Layout>
