---
import Layout from "../../layouts/Layout.astro";
import KuyangMark from "../../components/KuyangMark.astro";
import GhostSit from "../../components/GhostSit.astro";
import { byId, data, plateUrl } from "../../utils/data";
import { layout } from "../../utils/tree";
import { langOf, localeParams, localePath, regionName, useT, type Key } from "../../i18n";

export const getStaticPaths = localeParams;
const lang = langOf(Astro.params.locale);
const t = useT(lang);

const { meta } = data;
const L = layout(data.tree, (id) => byId.get(id)!.clade);

// Well-supported small clades, read straight from the tree.
const pairs = L.all
  .filter((p) => p.children.length && p.tips.length <= 3 && (p.support ?? 0) >= 90)
  .sort((a, b) => (b.support ?? 0) - (a.support ?? 0))
  .slice(0, 6)
  .map((p) => ({ support: p.support!, ghosts: p.tips.map((id) => byId.get(id)!) }));

const heroIds = ["kuntilanak_indonesian_archipelago", "pocong_java_indonesia", "banaspati_java_indonesia", "nyi_roro_kidul_java_bali", "rangda_bali_indonesia", "genderuwo_java_indonesia", "toyol_tuyul_indonesian_archipelago"].filter((id) => byId.has(id));
const islands = data.regions.filter((r) => r !== "Outgroup" && r !== "Widespread").length;
const stats = [
  { value: meta.taxa - meta.outgroups, label: t("statGhosts") },
  { value: meta.outgroups, label: t("statOutgroups") },
  { value: meta.characters, label: t("statChars") },
  { value: islands, label: t("statIslands") },
];

const views: { path: string; name: Key; kind: Key; blurb: Key; art: string }[] = [
  { path: "/atlas", name: "navAtlas", kind: "kindAtlas", blurb: "blurbAtlas", art: "atlas" },
  { path: "/lantern", name: "navLantern", kind: "kindLantern", blurb: "blurbLantern", art: "lantern" },
  { path: "/bestiary", name: "navBestiary", kind: "kindBestiary", blurb: "blurbBestiary", art: "bestiary" },
  { path: "/patterns", name: "navPatterns", kind: "kindPatterns", blurb: "blurbPatterns", art: "patterns" },
];
const bestiaryIds = ["kuntilanak_merah_java_indonesia", "babi_ngepet_java_indonesia", "orang_bati_seram_indonesia", "naga_besukih_bali_indonesia", "preta_indonesian_archipelago", "lampor_java_indonesia"].filter((id) => byId.has(id));
---

<Layout lang={lang} title={t("siteTitle")}>
  <section class="glass mt-6 px-5 py-10 text-center sm:mt-10 sm:px-10 sm:py-14">
    <p class="accent text-xs font-semibold uppercase tracking-[0.3em]" lang="id">{t("heroKicker")}</p>
    <h1 class="mx-auto mt-10 max-w-3xl text-balance pb-6 font-serif text-5xl font-semibold tracking-tight sm:text-6xl">
      {/* The last letter of "phylogeny" (y) or "Filogeni" (i) is a Kuyang; screen readers get the plain word. */}
      {
        lang === "id" ? (
          <>
            <span class="sr-only">Filogeni</span>
            <span aria-hidden="true" class="whitespace-nowrap">Fil<span class="relative">o<GhostSit /></span>gen<KuyangMark letter="i" /></span> hantu, <i>{t("literally")}</i>.
          </>
        ) : (
          <>
            Gh<span class="relative">o<GhostSit /></span>st <span class="sr-only">phylogeny</span>
            <span aria-hidden="true" class="whitespace-nowrap">phylogen<KuyangMark letter="y" /></span>, <i>{t("literally")}</i>.
          </>
        )
      }
    </h1>
    <p class="muted mx-auto mt-5 max-w-2xl text-pretty text-lg leading-relaxed" set:html={t("heroLead", meta.taxa - 3, meta.characters)} />
    <ul class="mt-10 flex flex-wrap items-end justify-center gap-3 sm:gap-5" aria-label={t("aFewGhosts")}>
      {
        heroIds.map((id, i) => {
          const g = byId.get(id)!;
          const size = i === 3 ? 132 : 92;
          return (
            <li>
              <a href={localePath(lang, `/ghosts/${id}`)} class="group block rounded-full" aria-label={g.name}>
                <img src={plateUrl(id)} alt="" width={size} height={size} class="animate-drift rounded-full shadow-xl shadow-malam-950/30 transition group-hover:scale-105" style={`animation-delay: ${i * -0.7}s`} />
              </a>
            </li>
          );
        })
      }
    </ul>
    <dl class="mx-auto mt-10 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-4">
      {
        stats.map((s) => (
          <div class="flex flex-col-reverse rounded-2xl border border-kafan-300 bg-kafan-100/70 p-4 dark:border-malam-700 dark:bg-malam-900/70">
            <dt class="muted text-sm">{s.label}</dt>
            <dd class="accent font-serif text-3xl font-semibold">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mt-10" aria-labelledby="views">
    <div class="glass px-6 py-6 text-center">
      <h2 id="views" class="font-serif text-3xl font-semibold tracking-tight">{t("fourWays")}</h2>
      <p class="muted mx-auto mt-2 max-w-2xl">{t("fourWaysLead")}</p>
    </div>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        views.map((v) => (
          <li>
            <a href={localePath(lang, v.path)} class="glass group flex h-full flex-col overflow-hidden transition hover:-translate-y-1">
              <div class={`flex h-40 items-center justify-center ${v.art === "lantern" ? "bg-night/90" : "bg-kafan-200/50 dark:bg-malam-900/50"}`} aria-hidden="true">
                {v.art === "atlas" && (
                  <svg viewBox="0 0 200 120" class="h-32 w-auto">
                    <g fill="none" stroke-width="2" stroke-linecap="round">
                      <path d="M10 60 H30 M30 25 V95 M30 25 H55 M55 15 V35 M30 95 H50 M50 55 V110" stroke="var(--neutral-branch)" />
                      <path d="M55 15 H80 M55 35 H80" stroke="var(--clade-0)" />
                      <path d="M50 55 H80 M50 80 H80" stroke="var(--clade-2)" />
                      <path d="M50 110 H80" stroke="var(--clade-7)" />
                    </g>
                    {[15, 35, 55, 80, 110].map((y, r) => (
                      <g>
                        <circle cx="88" cy={y} r="5" fill="#1c1830" />
                        {Array.from({ length: 8 }, (_, c) => (
                          <rect x={128 + c * 9} y={y - 4} width="7" height="7" rx="1.5" class={(r * 3 + c * 5) % 3 === 0 ? "fill-malam-800 dark:fill-prada-300" : "fill-none stroke-kafan-700 dark:stroke-kemenyan-400"} />
                        ))}
                      </g>
                    ))}
                  </svg>
                )}
                {v.art === "lantern" && (
                  <svg viewBox="-60 -60 120 120" class="h-32 w-auto">
                    <circle r="54" fill="none" stroke="#e0b03e" stroke-opacity=".3" />
                    {Array.from({ length: 28 }, (_, i) => {
                      const a = (i / 28) * Math.PI * 2;
                      return <path d={`M${Math.cos(a) * 22} ${Math.sin(a) * 22} L${Math.cos(a) * 44} ${Math.sin(a) * 44}`} stroke={`var(--clade-${i % 9})`} stroke-width="1.6" />;
                    })}
                    <circle r="18" fill="#110e1b" stroke="#e0b03e" stroke-width="1" />
                    <circle r="9" fill="#f1e9d8" class="animate-flicker" />
                  </svg>
                )}
                {v.art === "bestiary" && (
                  <div class="grid grid-cols-3 gap-2">
                    {bestiaryIds.map((id) => (
                      <span class="rounded-xl bg-kafan-50/80 p-1 dark:bg-malam-900/80">
                        <img src={plateUrl(id)} alt="" width="40" height="40" class="rounded-full" />
                      </span>
                    ))}
                  </div>
                )}
                {v.art === "patterns" && (
                  <svg viewBox="0 0 200 110" class="h-32 w-auto">
                    {Array.from({ length: 6 }, (_, r) =>
                      Array.from({ length: 8 }, (_, c) => <rect x={20 + c * 20} y={8 + r * 16} width="18" height="14" rx="3" style={`fill: var(--seq-${(r * 7 + c * 3) % 6})`} />),
                    )}
                  </svg>
                )}
              </div>
              <div class="flex flex-1 flex-col p-5">
                <p class="accent text-xs font-semibold uppercase tracking-widest">{t(v.kind)}</p>
                <h3 class="mt-1 font-serif text-2xl font-semibold">{t(v.name)}</h3>
                <p class="muted mt-1 flex-1 text-sm">{t(v.blurb)}</p>
                <span class="accent mt-4 text-sm font-semibold group-hover:underline">{t("open", t(v.name))} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="glass mt-10 p-6 sm:p-8" aria-labelledby="pairs">
    <h2 id="pairs" class="text-center font-serif text-3xl font-semibold tracking-tight">{t("kinships")}</h2>
    <p class="muted mx-auto mt-2 max-w-2xl text-center">{t("kinshipsLead", meta.strongNodes, meta.nodes)}</p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        pairs.map((p) => (
          <li class="flex items-center gap-3 rounded-2xl border border-kafan-300 bg-kafan-100/70 p-3 dark:border-malam-700 dark:bg-malam-900/70">
            <div class="flex shrink-0 -space-x-4">
              {p.ghosts.map((g) => (
                <img src={plateUrl(g.id)} alt="" width="52" height="52" class="rounded-full ring-2 ring-kafan-50 dark:ring-malam-900" />
              ))}
            </div>
            <div class="min-w-0">
              <p class="font-semibold leading-snug">
                {p.ghosts.map((g, i) => (
                  <>
                    {i > 0 && <span class="muted"> + </span>}
                    <a href={localePath(lang, `/ghosts/${g.id}`)} class="underline decoration-kafan-500 underline-offset-2 hover:decoration-darah-600">{g.name}</a>
                  </>
                ))}
              </p>
              <p class="muted text-sm">UFBoot {p.support} · {[...new Set(p.ghosts.map((g) => regionName(lang, g.regionGroup)))].join(", ")}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="glass mt-10 p-6 sm:p-8" aria-labelledby="how">
    <h2 id="how" class="font-serif text-2xl font-semibold tracking-tight">{t("howBuilt")}</h2>
    <ol class="mt-4 grid gap-4 text-sm sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          [t("stepParse"), t("stepParseText", meta.taxa)],
          [t("stepEncode"), t("stepEncodeText", meta.taxa, meta.characters)],
          [t("stepInfer"), t("stepInferText", meta.analysis.software, meta.analysis.model ?? "?")],
          [t("stepPublish"), t("stepPublishText")],
        ].map(([step, text], i) => (
          <li class="rounded-2xl border border-kafan-300 bg-kafan-100/70 p-4 dark:border-malam-700 dark:bg-malam-900/70">
            <span class="accent font-serif text-2xl font-semibold" aria-hidden="true">{i + 1}</span>
            <p class="mt-1 font-semibold">{step}</p>
            <p class="muted mt-1">{text}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-4 text-sm">
      {t("workflowNote")} <a href={localePath(lang, "/methods")} class="accent font-semibold underline underline-offset-2">{t("readMethods")}</a>.
    </p>
  </section>
</Layout>
