---
import Layout from "../layouts/Layout.astro";
import PageTitle from "../components/PageTitle.astro";
import Bestiary from "../islands/Bestiary";
import { data } from "../utils/data";
---

<Layout title="Bestiary · Ghost phylogeny, literally" wide>
  <PageTitle title="The bestiary" kicker="Field guide">
    All {data.ghosts.length} specimens, kept in tree order so neighbours are relatives. Filter by island, clade, danger, or trait, and tick two cards to compare them character by character.
  </PageTitle>
  <Bestiary client:load />
</Layout>
