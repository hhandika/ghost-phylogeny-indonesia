---
import Layout from "../layouts/Layout.astro";
import PageTitle from "../components/PageTitle.astro";
import CladeLegend from "../components/CladeLegend.astro";
import Atlas from "../islands/Atlas";
import { data } from "../utils/data";
---

<Layout title="Atlas · Ghost phylogeny, literally" wide>
  <PageTitle title="The atlas" kicker="Tree and traits">
    Every ghost on one maximum-likelihood tree, its {data.meta.characters} coded characters lined up beside it, the way a phylogenetics paper would draw it. Select a name, or search and press Enter, to read its card.
  </PageTitle>
  <CladeLegend />
  <Atlas client:load />
</Layout>
