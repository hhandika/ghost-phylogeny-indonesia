---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import "../styles/tailwind.css";
import { withBase } from "../utils/data";

interface Props {
  title: string;
  description?: string;
  /** Full-bleed pages (the designs) manage their own width. */
  wide?: boolean;
}

const {
  title,
  description = "An interactive maximum-likelihood phylogeny of Indonesian ghosts, spirits, and cryptids, built from a coded trait matrix with IQ-TREE.",
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400..700;1,400..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Apply the saved theme (or the system one) before first paint.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const system = matchMedia("(prefers-color-scheme: dark)");
        const apply = (dark) => document.documentElement.classList.toggle("dark", dark);
        apply(saved ? saved === "dark" : system.matches);
        system.addEventListener("change", (e) => {
          let current = null;
          try {
            current = localStorage.getItem("theme");
          } catch {}
          if (!current) apply(e.matches);
        });
      })();
    </script>
  </head>
  <body class="batik bg-paper text-malam-950 antialiased dark:bg-night dark:text-kafan-100">
    <div class="relative isolate min-h-screen overflow-x-clip">
      <!-- Moonglow at the top of every page. -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem] bg-[radial-gradient(ellipse_at_top,rgba(217,171,60,0.18),transparent_60%)] dark:bg-[radial-gradient(ellipse_at_top,rgba(125,116,230,0.22),transparent_60%)]"></div>
      <header class="sticky top-0 z-40 border-b border-transparent bg-paper/85 backdrop-blur-md dark:bg-night/85">
        <Navigation />
      </header>
      <main class={wide ? "px-4 lg:px-8" : "mx-auto max-w-5xl px-6"}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
