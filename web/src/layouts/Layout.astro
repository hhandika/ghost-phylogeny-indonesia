---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import Scene from "../components/Scene.astro";
import "../styles/tailwind.css";
import { withBase } from "../utils/data";

interface Props {
  title: string;
  description?: string;
  /** Full-bleed pages (the designs) manage their own width. */
  wide?: boolean;
}

const {
  title,
  description = "Ghost phylogeny, literally: a maximum-likelihood tree of Indonesian ghosts, spirits, and cryptids, built from a coded trait matrix with IQ-TREE.",
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400..700;1,400..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Apply the saved theme (or the system one) before first paint.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const system = matchMedia("(prefers-color-scheme: dark)");
        const apply = (dark) => document.documentElement.classList.toggle("dark", dark);
        apply(saved ? saved === "dark" : system.matches);
        system.addEventListener("change", (e) => {
          let current = null;
          try {
            current = localStorage.getItem("theme");
          } catch {}
          if (!current) apply(e.matches);
        });
      })();
    </script>
  </head>
  <body class="bg-paper text-malam-950 antialiased dark:bg-night dark:text-kafan-100">
    <a href="#main" class="sr-only z-50 rounded-full bg-malam-950 px-4 py-2 font-semibold text-prada-200 focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <Scene />
    <div class="relative isolate min-h-screen overflow-x-clip">
      <header class="sticky top-0 z-40 px-2 pt-3 sm:px-4 sm:pt-4">
        <div class="glass batik !rounded-full">
          <Navigation />
        </div>
      </header>
      <main id="main" tabindex="-1" class={`outline-none ${wide ? "px-3 sm:px-4 lg:px-8" : "mx-auto max-w-5xl px-3 sm:px-6"}`}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
