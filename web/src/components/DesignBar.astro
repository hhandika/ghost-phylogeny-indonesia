---
/** Tells the reader which candidate design they are looking at. */
import { withBase } from "../utils/data";
export const designs = [
  { path: "/atlas", letter: "A", name: "Atlas", blurb: "Tree, trait matrix, and detail card side by side." },
  { path: "/lantern", letter: "B", name: "Lantern", blurb: "A circular tree on a night canvas, one ghost lit at its centre." },
  { path: "/bestiary", letter: "C", name: "Bestiary", blurb: "A filterable field guide with side-by-side comparison." },
];
interface Props {
  current: string;
}
const { current } = Astro.props;
---

<div class="mx-auto mb-2 flex max-w-max flex-wrap items-center justify-center gap-2 rounded-full border border-dashed border-darah-400 px-3 py-1.5 text-xs dark:border-prada-400/60">
  <span class="font-semibold">Design preview</span>
  {
    designs.map((d) => (
      <a
        href={withBase(d.path)}
        aria-current={d.path === current ? "page" : undefined}
        class={`rounded-full px-2.5 py-0.5 transition ${d.path === current ? "bg-darah-700 text-kafan-50 dark:bg-prada-300 dark:text-malam-950" : "hover:bg-kafan-200 dark:hover:bg-malam-800"}`}
      >
        {d.letter} · {d.name}
      </a>
    ))
  }
</div>
