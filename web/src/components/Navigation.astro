---
import cntl from "cntl";
import Gunungan from "./Gunungan.astro";
import ThemeIcon from "./ThemeIcon.astro";
import { withBase } from "../utils/data";

const navItems = [
  { path: "/", label: "Overview" },
  { path: "/atlas", label: "Atlas" },
  { path: "/lantern", label: "Lantern" },
  { path: "/bestiary", label: "Bestiary" },
  { path: "/patterns", label: "Patterns" },
  { path: "/methods", label: "Methods" },
];

const here = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (path: string) => here === withBase(path).replace(/\/$/, "");

const linkBase = cntl`rounded-full px-3.5 py-1.5 font-semibold transition-colors duration-200`;
const active = cntl`bg-malam-900 text-prada-200 dark:bg-prada-300 dark:text-malam-950`;
const inactive = cntl`text-malam-900 hover:bg-kafan-200 dark:text-kafan-100 dark:hover:bg-malam-800`;
---

<nav class="flex items-center justify-between gap-3 py-3 pl-4 pr-3 sm:py-3.5 sm:pl-5" aria-label="Main">
  <a href={withBase("/")} class="group flex items-center gap-2 rounded-full">
    <Gunungan class="h-9 w-8 transition-transform duration-500 group-hover:rotate-6" />
    <span class="font-serif text-lg font-semibold leading-none tracking-tight">
      Ghost phylogeny<span class="hidden sm:inline">, <i>literally</i>.</span>
    </span>
  </a>
  <ul class="hidden items-center gap-1 lg:flex">
    {
      navItems.map(({ path, label }) => (
        <li>
          <a href={withBase(path)} aria-current={isCurrent(path) ? "page" : undefined} class={`${linkBase} ${isCurrent(path) ? active : inactive}`}>
            {label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="flex items-center gap-2">
    <ThemeIcon />
    <details class="relative lg:hidden" data-menu>
      <summary class="control flex h-10 w-10 cursor-pointer list-none items-center justify-center [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Menu</span>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </summary>
      <ul class="glass absolute right-0 z-50 mt-3 w-52 !rounded-2xl !bg-kafan-50/[0.97] p-2 dark:!bg-malam-950/[0.97]">
        {
          navItems.map(({ path, label }) => (
            <li>
              <a href={withBase(path)} aria-current={isCurrent(path) ? "page" : undefined} class={`block ${linkBase} ${isCurrent(path) ? active : inactive}`}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</nav>

<script>
  // Close the phone menu on Escape (returning focus) or a click outside it.
  document.querySelectorAll<HTMLDetailsElement>("details[data-menu]").forEach((menu) => {
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  });
</script>
