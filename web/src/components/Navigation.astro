---
import cntl from "cntl";
import Gunungan from "./Gunungan.astro";
import ThemeIcon from "./ThemeIcon.astro";
import MotionToggle from "./MotionToggle.astro";
import { HTML_LANG, LANG_NAME, localePath, useT, type Key, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** The current page in every language. */
  alternates: { lang: Lang; href: string }[];
}
const { lang, alternates } = Astro.props;
const t = useT(lang);

const navItems: { path: string; label: Key }[] = [
  { path: "/", label: "navOverview" },
  { path: "/atlas", label: "navAtlas" },
  { path: "/lantern", label: "navLantern" },
  { path: "/bestiary", label: "navBestiary" },
  { path: "/key", label: "navKey" },
  { path: "/patterns", label: "navPatterns" },
  { path: "/methods", label: "navMethods" },
];

const here = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (path: string) => here === localePath(lang, path).replace(/\/$/, "");

const linkBase = cntl`rounded-full px-3.5 py-1.5 font-semibold transition-colors duration-200`;
const active = cntl`bg-malam-900 text-prada-200 dark:bg-prada-300 dark:text-malam-950`;
const inactive = cntl`text-malam-900 hover:bg-kafan-200 dark:text-kafan-100 dark:hover:bg-malam-800`;
// Each language's link is labeled in that language.
const spoken: Record<Lang, string> = { en: "Read in American English", id: "Baca dalam Bahasa Indonesia" };
---

<nav class="flex items-center justify-between gap-3 py-3 pl-4 pr-3 sm:py-3.5 sm:pl-5" aria-label={t("navMain")}>
  <a href={localePath(lang, "/")} class="group flex min-w-0 items-center gap-2 rounded-full">
    <Gunungan class="h-9 w-8 shrink-0 transition-transform duration-500 group-hover:rotate-6" />
    <span class="sr-only font-serif text-lg font-semibold leading-none tracking-tight sm:not-sr-only sm:truncate">
      {t("siteName")}<span class="hidden md:inline">, <i>{t("literally")}</i>.</span>
    </span>
  </a>
  <ul class="hidden items-center gap-1 xl:flex">
    {
      navItems.map(({ path, label }) => (
        <li>
          <a href={localePath(lang, path)} aria-current={isCurrent(path) ? "page" : undefined} class={`${linkBase} ${isCurrent(path) ? active : inactive}`}>
            {t(label)}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
    <ul class="control flex h-10 items-center p-1 text-sm font-semibold" aria-label={t("language")}>
      {
        alternates.map((a) => (
          <li>
            <a
              href={a.href}
              hreflang={HTML_LANG[a.lang]}
              lang={HTML_LANG[a.lang]}
              aria-current={a.lang === lang ? "true" : undefined}
              aria-label={a.lang === lang ? LANG_NAME[a.lang] : spoken[a.lang]}
              title={LANG_NAME[a.lang]}
              class={`flex h-8 min-w-[2.25rem] items-center justify-center rounded-full px-2 uppercase transition ${a.lang === lang ? active : inactive}`}
            >
              {a.lang}
            </a>
          </li>
        ))
      }
    </ul>
    <MotionToggle lang={lang} />
    <ThemeIcon lang={lang} />
    <details class="relative xl:hidden" data-menu>
      <summary class="control flex h-10 w-10 cursor-pointer list-none items-center justify-center [&::-webkit-details-marker]:hidden">
        <span class="sr-only">{t("menu")}</span>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </summary>
      <ul class="glass absolute right-0 z-50 mt-3 w-52 !rounded-2xl !bg-kafan-50/[0.97] p-2 dark:!bg-malam-950/[0.97]">
        {
          navItems.map(({ path, label }) => (
            <li>
              <a href={localePath(lang, path)} aria-current={isCurrent(path) ? "page" : undefined} class={`block ${linkBase} ${isCurrent(path) ? active : inactive}`}>
                {t(label)}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</nav>

<script>
  // Close the phone menu on Escape (returning focus) or a click outside it.
  document.querySelectorAll<HTMLDetailsElement>("details[data-menu]").forEach((menu) => {
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  });
</script>
