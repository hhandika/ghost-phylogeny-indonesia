---
/**
 * Pauses and resumes every animation on the site (WCAG 2.2.2 Pause, Stop,
 * Hide). The choice is remembered; without one, the system's reduced-motion
 * setting decides.
 */
import { useT, type Lang } from "../i18n";
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---

<button
  type="button"
  data-motion-toggle
  class="control inline-flex h-10 w-10 items-center justify-center transition hover:text-darah-700 dark:hover:text-prada-300"
  aria-pressed="false"
  aria-label={t("pauseMotion")}
  title={t("pauseMotion")}
  data-label-pause={t("pauseMotion")}
  data-label-play={t("playMotion")}
>
  <svg data-icon="pause" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
  <svg data-icon="play" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
</button>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-motion-toggle]");
  const sync = () => {
    const off = root.dataset.motion === "off";
    buttons.forEach((b) => {
      b.setAttribute("aria-pressed", String(off));
      const label = (off ? b.dataset.labelPlay : b.dataset.labelPause) ?? "";
      b.setAttribute("aria-label", label);
      b.title = label;
      b.querySelector('[data-icon="pause"]')?.classList.toggle("hidden", off);
      b.querySelector('[data-icon="play"]')?.classList.toggle("hidden", !off);
    });
  };
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const off = root.dataset.motion !== "off";
      root.dataset.motion = off ? "off" : "on";
      try {
        localStorage.setItem("motion", root.dataset.motion);
      } catch {}
      sync();
    }),
  );
  sync();
</script>
