---
interface Props {
  title: string;
  kicker?: string;
}
const { title, kicker } = Astro.props;
---

<div class="glass mx-auto mb-6 mt-6 max-w-3xl px-6 py-8 text-center sm:mt-10 sm:px-10">
  {kicker && <p class="accent text-xs font-semibold uppercase tracking-[0.25em]">{kicker}</p>}
  <h1 class="mt-2 text-balance font-serif text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
  <div class="muted mt-4 text-pretty text-base leading-relaxed">
    <slot />
  </div>
</div>
