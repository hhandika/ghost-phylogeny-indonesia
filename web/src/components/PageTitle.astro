---
interface Props {
  title: string;
  kicker?: string;
}
const { title, kicker } = Astro.props;
---

<div class="mx-auto max-w-3xl pb-6 pt-8 text-center sm:pt-12">
  {kicker && <p class="text-xs font-semibold uppercase tracking-[0.25em] text-darah-700 dark:text-prada-300">{kicker}</p>}
  <h1 class="mt-2 text-balance font-serif text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
  <div class="mt-4 text-pretty text-base leading-relaxed text-kafan-800 dark:text-kemenyan-200">
    <slot />
  </div>
</div>
