---
/**
 * A Kuntilanak sitting on top of a letter "o" in the hero title: long black
 * hair down past her shoulders, pale face and red eyes, a white gown whose
 * tattered hem drapes over the front of the letter, and bare feet swinging.
 * Wrap the letter:
 *   <span class="relative">o<GhostSit /></span>
 * Sized in em, so it scales with the title. Decorative: the letter stays text.
 * Outlines use currentColor so she stays visible on light and dark glass.
 * `shift` nudges her sideways (em) to clear a tall neighbor such as "l".
 */
const { shift = 0 } = Astro.props as { shift?: number };
---

<svg viewBox="0 0 100 120" class="ghost-sit" style={`--ghost-sit-x:${shift}em`} aria-hidden="true" focusable="false">
  <g class="ghost-sit-body">
    <!-- bare feet dangling over the front of the o -->
    <g class="ghost-sit-leg ghost-sit-leg-l">
      <path d="M42 92 C41 101 40 107 37 113" fill="none" stroke="currentColor" stroke-width="7.5" stroke-linecap="round"></path>
      <path d="M42 92 C41 101 40 107 37 113" fill="none" stroke="#efe6d6" stroke-width="4" stroke-linecap="round"></path>
      <path d="M31 115 C31 111 39 110 41 113 C41 116 33 118 31 115 Z" fill="#efe6d6" stroke="currentColor" stroke-width="2.4"></path>
    </g>
    <g class="ghost-sit-leg ghost-sit-leg-r">
      <path d="M58 92 C59 101 60 107 63 113" fill="none" stroke="currentColor" stroke-width="7.5" stroke-linecap="round"></path>
      <path d="M58 92 C59 101 60 107 63 113" fill="none" stroke="#efe6d6" stroke-width="4" stroke-linecap="round"></path>
      <path d="M69 115 C69 111 61 110 59 113 C59 116 67 118 69 115 Z" fill="#efe6d6" stroke="currentColor" stroke-width="2.4"></path>
    </g>

    <!-- long hair behind, falling past the shoulders -->
    <g class="ghost-sit-hair">
      <path d="M33 16 C22 34 20 62 24 86 C28 82 32 86 34 80 L66 80 C68 86 72 82 76 86 C80 62 78 34 67 16 Z" fill="#0b0910" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"></path>
    </g>

    <!-- white gown: narrow shoulders, wide lap, tattered hem over the o -->
    <path
      d="M40 38 C36 46 34 56 26 66 C20 76 14 84 13 92 Q16.5 88 20 94 Q26 88 32 95 Q38 89 44 95 Q50 89 56 95 Q62 89 68 95 Q74 88 80 94 Q83.5 88 87 92 C86 84 80 76 74 66 C66 56 64 46 60 38 Z"
      fill="#f6f1e6"
      stroke="currentColor"
      stroke-width="3.5"
      stroke-linejoin="round"></path>
    <path d="M30 76 C34 82 36 88 34 93 M50 70 V93 M70 76 C66 82 64 88 66 93" fill="none" stroke="#d4c6aa" stroke-width="2.4" stroke-linecap="round"></path>

    <!-- arms resting on her lap, long nails -->
    <path d="M40 42 C32 52 30 62 36 70" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round"></path>
    <path d="M40 42 C32 52 30 62 36 70" fill="none" stroke="#efe6d6" stroke-width="3.5" stroke-linecap="round"></path>
    <path d="M60 42 C68 52 70 62 64 70" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round"></path>
    <path d="M60 42 C68 52 70 62 64 70" fill="none" stroke="#efe6d6" stroke-width="3.5" stroke-linecap="round"></path>
    <path d="M36 70 l3 5 M36 70 l0.5 6 M64 70 l-3 5 M64 70 l-0.5 6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>

    <!-- head: pale face framed by hair parted down the middle -->
    <ellipse cx="50" cy="26" rx="11" ry="13" fill="#efe6d6" stroke="currentColor" stroke-width="3"></ellipse>
    <path d="M37 22 C38 8 62 8 63 22 C64 34 66 44 68 54 C64 46 61 34 59 24 C56 18 44 18 41 24 C39 34 36 46 32 54 C34 44 36 34 37 22 Z" fill="#0b0910" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
    <g class="ghost-sit-eyes">
      <circle cx="46" cy="27" r="3.4" fill="#ff4a4a" opacity="0.35"></circle>
      <circle cx="54" cy="27" r="3.4" fill="#ff4a4a" opacity="0.35"></circle>
      <circle cx="46" cy="27" r="1.7" fill="#d1182e"></circle>
      <circle cx="54" cy="27" r="1.7" fill="#d1182e"></circle>
    </g>
    <ellipse cx="50" cy="34" rx="1.6" ry="2.4" fill="#15111f"></ellipse>
    <!-- a frangipani in her hair -->
    <g transform="translate(62 16)">
      <ellipse cx="0" cy="-2.6" rx="1.8" ry="2.6" fill="#fff8ec" stroke="currentColor" stroke-width="0.6"></ellipse>
      <ellipse cx="2.5" cy="0.6" rx="1.8" ry="2.6" fill="#fff8ec" stroke="currentColor" stroke-width="0.6" transform="rotate(72 2.5 0.6)"></ellipse>
      <ellipse cx="-2.5" cy="0.6" rx="1.8" ry="2.6" fill="#fff8ec" stroke="currentColor" stroke-width="0.6" transform="rotate(-72 -2.5 0.6)"></ellipse>
      <circle r="1" fill="#f2c14e"></circle>
    </g>
  </g>
</svg>

<style>
  /* Sits on the o: the gown's hem rests on the top of the letter
     (Newsreader 600 o reaches 0.461em above the baseline; measured). */
  .ghost-sit {
    position: absolute;
    left: 50%;
    width: 0.58em;
    height: 0.692em;
    bottom: var(--ghost-sit-bottom, 0.545em);
    transform: translateX(calc(-50% + var(--ghost-sit-x, 0em)));
    overflow: visible;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ghost-sit-body {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: ghost-sit-rock 5s ease-in-out infinite;
    }
    .ghost-sit-hair {
      transform-box: fill-box;
      transform-origin: 50% 0%;
      animation: ghost-sit-sway 3.2s ease-in-out infinite alternate;
    }
    .ghost-sit-leg {
      transform-box: fill-box;
      transform-origin: 50% 0%;
      animation: ghost-sit-kick 1.1s ease-in-out infinite alternate;
    }
    .ghost-sit-leg-r {
      animation-delay: -0.55s;
    }
    .ghost-sit-eyes {
      animation: ghost-sit-glow 2.8s ease-in-out infinite;
    }
  }
  @keyframes ghost-sit-rock {
    0%, 100% { transform: rotate(-2deg); }
    50% { transform: rotate(2deg); }
  }
  @keyframes ghost-sit-sway {
    from { transform: skewX(-3deg); }
    to { transform: skewX(3deg); }
  }
  @keyframes ghost-sit-kick {
    from { transform: rotate(-16deg); }
    to { transform: rotate(16deg); }
  }
  @keyframes ghost-sit-glow {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }
</style>
