---
import { localePath, useT, type Lang } from "../i18n";
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const year = new Date().getFullYear();
const sourceUrl = "https://github.com/hhandika/ghost-phylogeny-indonesia";
---

<footer class="mx-auto mt-20 max-w-5xl px-3 pb-10 sm:px-6">
  <div class="glass batik flex flex-col items-center justify-between gap-3 px-6 py-6 text-sm sm:flex-row">
    <p class="font-serif text-base font-semibold">{t("siteName")}, <i>{t("literally")}</i>.</p>
    <p class="muted flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
      <span>© {year} Heru Handika</span>
      <a href={localePath(lang, "/methods")} class="accent font-semibold underline underline-offset-2">{t("navMethods")}</a>
      <a href={sourceUrl} target="_blank" rel="noopener" class="accent font-semibold underline underline-offset-2">GitHub<span class="sr-only"> {t("newTab")}</span></a>
    </p>
  </div>
</footer>
