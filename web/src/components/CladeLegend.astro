---
import { data } from "../utils/data";
const counts = new Map<string, number>();
data.ghosts.forEach((g) => counts.set(g.clade, (counts.get(g.clade) ?? 0) + 1));
---

<div class="glass mx-auto mb-4 max-w-5xl px-4 py-3">
  <h2 class="sr-only">Clade colours</h2>
  <ul class="flex flex-wrap justify-center gap-x-4 gap-y-1.5 text-sm">
    {
      data.clades.map((c, i) => (
        <li class="inline-flex items-center gap-1.5">
          <span class="h-3 w-3 rounded-full border border-malam-950/30 dark:border-white/30" style={`background: var(--clade-${i})`} />
          {c} <span class="muted">{counts.get(c)}</span>
        </li>
      ))
    }
  </ul>
</div>
